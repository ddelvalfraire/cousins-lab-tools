{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../.."
  },
  "files": {
    "includes": [
      "**",
      "!!**/src-tauri",
      "!!**/dist",
      "!!**/storybook-static",
      "!!**/test-results",
      "!!**/playwright-report",
      "!lint/fixtures",
      "!src/App.tsx",
      "!src/main.tsx",
      "!public/tauri.svg",
      "!vite.config.ts",
      "!scripts/clean.mjs",
      "!bun.lock"
    ]
  },
  "extends": ["./lint/effects.json"],
  "plugins": ["./lint/no-effect-hooks.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "all",
        "noLabelWithoutControl": {
          "level": "on",
          "options": {
            "inputComponents": ["Select"]
          }
        },
        "noNoninteractiveTabindex": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noImportantStyles": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/features/acquisition/AcquisitionControls.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 58
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/calibration/CalibrationChecklist.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 39
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/experiments/ExperimentSetupForm.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 47
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/components/PresetEditor.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
