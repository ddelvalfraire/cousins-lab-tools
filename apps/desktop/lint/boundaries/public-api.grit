language js

// Applies everywhere. fixtures.ts is a feature's second entry point, for the sample data that app stories reuse.
// Files outside src/features/ reach a feature by alias or by a relative path: './features/x/y' from a file directly in
// src/, './src/features/x/y' from the app root, '../src/features/x/y' from .storybook/ or tests/, and './x/y' from a
// file directly in src/features/.
or {
  JsModuleSource() as $source,
  JsStringLiteralExpression() as $source where {
    $source <: within JsImportCallExpression()
  },
  TsImportTypeArguments() as $arguments where {
    $arguments <: contains TsStringLiteralType() as $source
  }
} where {
  or {
    $source <: r"['\"](?:@/|\./(?:src/)?|(?:\.\./)+(?:src/)?)features/[^/'\"]+/.+['\"]",
    and {
      $filename <: r".*/src/features/[^/]+",
      $source <: r"['\"]\./[^/'\"]+/.+['\"]"
    }
  },
  not $source <: r"['\"](?:@/|\./(?:src/)?|(?:\.\./)+(?:src/)?)(?:features/)?[^/'\"]+/fixtures['\"]",
  register_diagnostic(span=$source, message="Import a feature through its public API: @/features/<name> (its index.ts), or @/features/<name>/fixtures for sample data.", severity="error")
}
