language js

// Applies everywhere. The other boundary rules read an import path as written, so `..` after a folder name
// ('@/shared/../features/x/y', './../x'), a `.` segment after the first ('@/./features/x/y', '././x') or an empty
// segment ('@/features//x/y') would reach a slice they never see. A backslash is rejected too: an escape such as
// '@/\x66eatures/x/y' spells a path the patterns can't read. So is a leading `/`, which Vite resolves from the app
// root ('/src/features/x/y') and no other rule reads. An import() call must take one plain string as its path: a
// template literal, a concatenation, a variable or any other expression is rejected, because the other rules read
// only plain strings, and tsc and Vite resolve import(`@/features/x/y`) or import('@/' + 'features/x/y') like one.
or {
  or {
    JsModuleSource() as $source,
    JsStringLiteralExpression() as $source where {
      $source <: within JsImportCallExpression()
    },
    TsImportTypeArguments() as $arguments where {
      $arguments <: contains TsStringLiteralType() as $source
    }
  } where {
    or {
      $source <: r"['\"](?:[^'\"]*/)?(?:[^./'\"][^/'\"]*|\.[^./'\"][^/'\"]*|\.\.[^/'\"]+|\.)/\.\.(?:/[^'\"]*)?['\"]",
      $source <: r"['\"][^'\"]*/\.(?:/[^'\"]*)?['\"]",
      $source <: r"['\"][^'\"]*//[^'\"]*['\"]",
      $source <: r"['\"][^'\"]*\\[^'\"]*['\"]",
      $source <: r"['\"]/[^'\"]*['\"]"
    }
  },
  JsTemplateExpression() as $source where {
    $source <: within JsImportCallExpression()
  },
  JsImportCallExpression() as $source where {
    not $source <: contains `import($first, $...)` where {
      $first <: JsStringLiteralExpression()
    }
  }
} where {
  register_diagnostic(span=$source, message="Write import paths as plain strings, without a leading `/`, without `..` after a folder name, without `.` after the first segment, without `//` and without escapes, so the boundary rules see where they lead. An import() takes one plain string.", severity="error")
}
