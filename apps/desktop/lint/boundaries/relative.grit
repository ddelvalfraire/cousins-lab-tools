language js

// Applies to src/**. The layer rules match import paths, so a relative path that climbs out of its folder could slip
// past them; only the repository's DVDash brand SVGs, from BrandMark.tsx, and the Storybook setup, from story files, sit
// outside src. Any other file reaching either could use a file there as a bridge to another feature.
or {
  JsModuleSource() as $source,
  JsStringLiteralExpression() as $source where {
    $source <: within JsImportCallExpression()
  },
  TsImportTypeArguments() as $arguments where {
    $arguments <: contains TsStringLiteralType() as $source
  }
} where {
  $source <: r"['\"]\.\.(?:/.*)?['\"]",
  not and {
    $filename <: r".*/src/shared/ui/BrandMark\.tsx",
    $source <: r"['\"]\.\./\.\./\.\./\.\./\.\./assets/branding/dvdash/icon\.svg['\"]"
  },
  or {
    not $source <: r"['\"](?:\.\./)+\.storybook/.*['\"]",
    not $filename <: r".*\.stories\.tsx?"
  },
  register_diagnostic(span=$source, message="Relative imports stay inside their folder. Import another folder through @/shared/..., @/features/<name> or @/app/..., the brand SVGs only from BrandMark.tsx, and .storybook/ only from a story.", severity="error")
}
