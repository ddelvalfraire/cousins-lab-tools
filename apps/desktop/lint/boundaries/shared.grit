language js

// Applies to src/shared/**. Any alias other than @/shared reaches a feature, the app, or a file elsewhere in src that
// could re-export either.
or {
  JsModuleSource() as $source,
  JsStringLiteralExpression() as $source where {
    $source <: within JsImportCallExpression()
  },
  TsImportTypeArguments() as $arguments where {
    $arguments <: contains TsStringLiteralType() as $source
  }
} where {
  $source <: r"['\"]@/.*['\"]",
  not $source <: r"['\"]@/shared(?:/.*)?['\"]",
  register_diagnostic(span=$source, message="src/shared is used by every feature and by the app, so it imports only from src/shared.", severity="error")
}
