language js

// Applies to src/features/**. Inside a feature, files import each other by relative path, so any alias other than
// @/shared reaches another feature, the app, or a file elsewhere in src that could re-export either.
or {
  JsModuleSource() as $source,
  JsStringLiteralExpression() as $source where {
    $source <: within JsImportCallExpression()
  },
  TsImportTypeArguments() as $arguments where {
    $arguments <: contains TsStringLiteralType() as $source
  }
} where {
  $source <: r"['\"]@/.*['\"]",
  not $source <: r"['\"]@/shared(?:/.*)?['\"]",
  register_diagnostic(span=$source, message="A feature imports only its own files and src/shared. Compose features in src/app, or move what two features need to src/shared.", severity="error")
}
